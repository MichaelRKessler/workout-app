# Next.js reads this file. Copy it to .env.local and fill in the real URL.
# `npx convex dev` prints the value and writes it for you.
#
# Convex dashboard: Settings → URL & Deploy Key → deployment URL ending in .convex.cloud
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# The Convex CLI also writes CONVEX_DEPLOYMENT into .env.local. Leave that file
# gitignored. Do not put Google or JWT secrets in this file.
#
# Server-only Gemini key for voice logging. The browser never receives it.
# Do not rename this to NEXT_PUBLIC_GEMINI_API_KEY.
# Set it in .env.local for local Next.js, and later in the Vercel project
# environment. It is not a Convex deployment variable.
GEMINI_API_KEY=your-gemini-api-key
#
# Optional override for the Flash model. The default is gemini-3.8-flash,
# set in lib/voice/model.ts. Same Next.js server environment as the key.
# GEMINI_MODEL=gemini-3.8-flash
#
# Set these on the Convex deployment (dashboard Environment Variables, or
# `npx convex env set NAME value`), not in Next.js:
#
# SITE_URL=http://localhost:3000
# JWT_PRIVATE_KEY=
# JWKS=
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
